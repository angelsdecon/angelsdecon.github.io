<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/" aria-label="home">
        <span class="brand-handle">angelsdecon</span>
        <span class="brand-mark">Á.&lt;/3</span>
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only" data-i18n="toggle_navigation">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              <span data-i18n="about_title">{{- about_title }}</span>
              {% if page.permalink == '/' %}
                <span class="sr-only" data-i18n="current">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search (text-only) -->
            <li class="nav-item">
              <button id="search-toggle" title="search" onclick="openSearchModal()">
                <span class="nav-link" data-i18n="search">search</span>
              </button>
            </li>
          {% endif %}
          <li class="nav-item lang-switch lang-divider">
            <a class="nav-link" href="{{ page.url | relative_url }}?lang=es">[esp]</a>
          </li>
          <li class="nav-item lang-switch">
            <a class="nav-link" href="{{ page.url | relative_url }}?lang=en">[eng]</a>
          </li>
          {% if site.enable_darkmode %}
            <!-- Toggle theme mode (text-only) -->
            <li class="toggle-container">
              <button id="light-toggle" title="change theme">
                <span class="nav-link" data-i18n="theme">theme</span>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var lang = params.get("lang") || localStorage.getItem("site_lang") || "{{ site.lang | default: 'en' }}";
      if (lang) {
        localStorage.setItem("site_lang", lang);
        document.documentElement.setAttribute("lang", lang);
      }

      var links = document.querySelectorAll(".lang-switch a");
      for (var i = 0; i < links.length; i++) {
        var href = links[i].getAttribute("href") || "";
        if (href.indexOf("lang=" + lang) !== -1) links[i].classList.add("active-lang");
      }
    })();
  </script>
  <script>
    /* expose translations as JSON for client-side switching */
    window._i18n = {{ site.data.i18n | jsonify }};

    (function () {
      function getNested(obj, key) {
        if (!obj) return undefined;
        var parts = key.split('.');
        var cur = obj;
        for (var i = 0; i < parts.length; i++) {
          cur = cur[parts[i]];
          if (cur === undefined) return undefined;
        }
        return cur;
      }

      function translateUI(lang) {
        if (!window._i18n) return;
        var dict = window._i18n[lang] || window._i18n[Object.keys(window._i18n)[0]] || {};
        var nodes = document.querySelectorAll('[data-i18n]');
        nodes.forEach(function (n) {
          var key = n.getAttribute('data-i18n');
          var val = getNested(dict, key);
          if (val !== undefined && val !== null) n.textContent = val;
        });
      }

      var params = new URLSearchParams(window.location.search);
      var lang = params.get('lang') || localStorage.getItem('site_lang') || document.documentElement.getAttribute('lang') || '{{ site.lang | default: "en" }}';
      if (lang) translateUI(lang);

      // update when language link clicked (links set site_lang in earlier script)
      document.querySelectorAll('.lang-switch a').forEach(function (a) {
        a.addEventListener('click', function () {
          var href = a.getAttribute('href') || '';
          var m = href.match(/lang=(\w+)/);
          var newLang = m ? m[1] : null;
          if (newLang) {
            setTimeout(function () { translateUI(newLang); }, 10);
          }
        });
      });
    })();
  </script>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
