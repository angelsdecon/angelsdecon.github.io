<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center" style="width: 75px">
          {% if content.date %}
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
              {{ content.date | date: '%Y' }}
            </span>
          {% endif %}
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4 text-lowercase">
            {{ content.title }}
          </h6>
          <h6 class="ml-1 ml-md-4 text-lowercase" style="font-size: 0.95rem">{{ content.event }}</h6>
          <h6 class="ml-1 ml-md-4 text-lowercase" style="font-size: 0.95rem; font-style: italic">{{ content.location }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
